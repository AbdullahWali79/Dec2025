    def load_medicines(self):
        try:
            df = pd.read_excel('medicines.xlsx')
            if 'Medicine_Name' not in df.columns or 'Price' not in df.columns or 'Stock' not in df.columns:
                raise ValueError("Excel must have columns: Medicine_Name, Price, Stock")
            
            # Add new columns if they don't exist
            if 'Rack_Number' not in df.columns:
                df['Rack_Number'] = ''
            if 'MG' not in df.columns:
                df['MG'] = ''
            if 'Actual_Price' not in df.columns:
                df['Actual_Price'] = df['Price']  # Default to Price if not set
            
            return df
        except FileNotFoundError:
            # Create sample Excel with new columns if not found
            sample_df = pd.DataFrame({
                'Medicine_Name': ['Paracetamol', 'Kaifa', 'Kaiga'],
                'Price': [10.5, 25.0, 15.0],
                'Stock': [100, 50, 30],
                'Rack_Number': ['R001', 'R002', 'R003'],
                'MG': ['500mg', '200mg', '100mg'],
                'Actual_Price': [10.5, 25.0, 15.0]
            })
            sample_df.to_excel('medicines.xlsx', index=False)
            messagebox.showinfo("Info", "Sample medicines.xlsx created. Add your data and restart.")
            return sample_df
    
    def update_medicines_dict(self):
        self.medicines = {}
        for _, row in self.medicines_df.iterrows():
            self.medicines[row['Medicine_Name'].lower()] = {
                'price': row['Price'],
                'stock': row['Stock'],
                'rack_number': row.get('Rack_Number', ''),
                'mg': row.get('MG', ''),
                'actual_price': row.get('Actual_Price', row['Price'])
            }
        # Debug: Print loaded medicines
        print("Loaded medicines:", list(self.medicines.keys())[:5])  # Show first 5
    
    def save_medicines(self):
        self.medicines_df.to_excel('medicines.xlsx', index=False)
        messagebox.showinfo("Success", "Medicines saved to Excel!")
    
