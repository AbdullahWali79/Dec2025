    def export_client_data(self, event=None):
        """Export client machine data in multiple formats"""
        try:
            from machine_id_validator import MachineIDValidator
            import json
            import csv
            import pandas as pd
            from datetime import datetime
            
            # Get client data
            validator = MachineIDValidator()
            machines = validator.list_authorized_machines()
            
            if not machines:
                messagebox.showwarning("Warning", "No client data found to export!")
                return
            
            # Create export timestamp
            timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
            
            # Prepare client data
            client_data = []
            for machine in machines:
                client_data.append({
                    'machine_id': machine['id'],
                    'machine_name': machine['name'],
                    'export_date': datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
                    'status': 'Authorized'
                })
            
            # Create export window
            export_window = tk.Toplevel(self.root)
            export_window.title("📊 Export Client Data")
            export_window.geometry("500x400")
            export_window.configure(bg='#f8f9fa')
            export_window.resizable(False, False)
            
            # Center the window
            export_window.transient(self.root)
            export_window.grab_set()
            
            # Main frame
            main_frame = tk.Frame(export_window, bg='#f8f9fa', padx=20, pady=20)
            main_frame.pack(fill=tk.BOTH, expand=True)
            
            # Title
            title_label = tk.Label(main_frame, text="📊 Export Client Data", 
                                  font=('Segoe UI', 16, 'bold'), 
                                  fg='#2c3e50', bg='#f8f9fa')
            title_label.pack(pady=(0, 20))
            
            # Client list display
            list_frame = tk.Frame(main_frame, bg='#f8f9fa')
            list_frame.pack(fill=tk.BOTH, expand=True, pady=(0, 20))
            
            tk.Label(list_frame, text="Current Clients:", 
                    font=('Segoe UI', 12, 'bold'), 
                    fg='#34495e', bg='#f8f9fa').pack(anchor=tk.W)
            
            # Create listbox for clients
            listbox = tk.Listbox(list_frame, font=('Segoe UI', 10), 
                               bg='white', fg='#2c3e50', height=8)
            listbox.pack(fill=tk.BOTH, expand=True, pady=(10, 0))
            
            # Add clients to listbox
            for i, client in enumerate(client_data, 1):
                listbox.insert(tk.END, f"{i}. {client['machine_name']} ({client['machine_id']})")
            
            # Export options
            options_frame = tk.Frame(main_frame, bg='#f8f9fa')
            options_frame.pack(fill=tk.X, pady=(0, 20))
            
            tk.Label(options_frame, text="Export Format:", 
                    font=('Segoe UI', 12, 'bold'), 
                    fg='#34495e', bg='#f8f9fa').pack(anchor=tk.W)
            
            # Format selection
            format_var = tk.StringVar(value="all")
            format_frame = tk.Frame(options_frame, bg='#f8f9fa')
            format_frame.pack(fill=tk.X, pady=(10, 0))
            
            tk.Radiobutton(format_frame, text="All Formats (JSON, CSV, Excel)", 
                          variable=format_var, value="all", 
                          font=('Segoe UI', 10), bg='#f8f9fa', fg='#2c3e50').pack(anchor=tk.W)
            tk.Radiobutton(format_frame, text="JSON Only", 
                          variable=format_var, value="json", 
                          font=('Segoe UI', 10), bg='#f8f9fa', fg='#2c3e50').pack(anchor=tk.W)
            tk.Radiobutton(format_frame, text="CSV Only", 
                          variable=format_var, value="csv", 
                          font=('Segoe UI', 10), bg='#f8f9fa', fg='#2c3e50').pack(anchor=tk.W)
            tk.Radiobutton(format_frame, text="Excel Only", 
                          variable=format_var, value="excel", 
                          font=('Segoe UI', 10), bg='#f8f9fa', fg='#2c3e50').pack(anchor=tk.W)
            
            # Buttons frame
            button_frame = tk.Frame(main_frame, bg='#f8f9fa')
            button_frame.pack(fill=tk.X)
            
            def perform_export():
                try:
                    format_choice = format_var.get()
                    exported_files = []
                    
                    if format_choice == "all" or format_choice == "json":
                        # Export JSON
                        json_filename = f"client_data_export_{timestamp}.json"
                        export_data = {
                            'export_info': {
                                'export_date': datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
                                'total_clients': len(client_data),
                                'exported_by': 'Pharmacy System'
                            },
                            'clients': client_data
                        }
                        with open(json_filename, 'w', encoding='utf-8') as f:
                            json.dump(export_data, f, indent=4, ensure_ascii=False)
                        exported_files.append(json_filename)
                    
                    if format_choice == "all" or format_choice == "csv":
                        # Export CSV
                        csv_filename = f"client_data_export_{timestamp}.csv"
                        with open(csv_filename, 'w', newline='', encoding='utf-8') as f:
                            if client_data:
                                writer = csv.DictWriter(f, fieldnames=client_data[0].keys())
                                writer.writeheader()
                                writer.writerows(client_data)
                        exported_files.append(csv_filename)
                    
                    if format_choice == "all" or format_choice == "excel":
                        # Export Excel
                        excel_filename = f"client_data_export_{timestamp}.xlsx"
                        df = pd.DataFrame(client_data)
                        with pd.ExcelWriter(excel_filename, engine='openpyxl') as writer:
                            df.to_excel(writer, sheet_name='Client_Data', index=False)
                            # Summary sheet
                            summary_data = {
                                'Export_Date': [datetime.now().strftime("%Y-%m-%d %H:%M:%S")],
                                'Total_Clients': [len(client_data)],
                                'Export_Format': [format_choice.title()],
                                'System': ['Pharmacy Invoice Generator']
                            }
                            summary_df = pd.DataFrame(summary_data)
                            summary_df.to_excel(writer, sheet_name='Export_Summary', index=False)
                        exported_files.append(excel_filename)
                    
                    # Show success message
                    if exported_files:
                        file_list = "\n".join([f"📄 {os.path.abspath(f)}" for f in exported_files])
                        messagebox.showinfo("Export Successful", 
                                          f"Client data exported successfully!\n\nFiles created:\n{file_list}")
                        export_window.destroy()
                    else:
                        messagebox.showerror("Export Failed", "No files were created!")
                        
                except Exception as e:
                    messagebox.showerror("Export Error", f"Failed to export data: {str(e)}")
            
            def cancel_export():
                export_window.destroy()
            
            # Export button
            export_btn = tk.Button(button_frame, text="📊 Export Data", 
                                 command=perform_export,
                                 font=('Segoe UI', 10, 'bold'),
                                 bg='#8b5cf6', fg='white',
                                 relief='flat', bd=0,
                                 padx=20, pady=8,
                                 cursor='hand2',
                                 activebackground='#7c3aed',
                                 activeforeground='white')
            export_btn.pack(side=tk.LEFT, padx=(0, 10))
            
            # Cancel button
            cancel_btn = tk.Button(button_frame, text="❌ Cancel", 
                                 command=cancel_export,
                                 font=('Segoe UI', 10, 'bold'),
                                 bg='#dc3545', fg='white',
                                 relief='flat', bd=0,
                                 padx=20, pady=8,
                                 cursor='hand2',
                                 activebackground='#c82333',
                                 activeforeground='white')
            cancel_btn.pack(side=tk.LEFT)
            
            # Bind Enter key to export
            export_window.bind('<Return>', lambda e: perform_export())
            export_window.bind('<Escape>', lambda e: cancel_export())
            
        except ImportError as e:
            messagebox.showerror("Import Error", f"Required modules not available: {str(e)}")
        except Exception as e:
            messagebox.showerror("Export Error", f"Failed to export client data: {str(e)}")
    
    def exit_fullscreen(self, event=None):
        """Exit fullscreen mode"""
        self.root.attributes('-fullscreen', False)
        return "break"

