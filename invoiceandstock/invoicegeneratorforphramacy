    def show_medicine_info(self, med_name):
        """Display medicine MG and Rack Number when selected"""
        med_lower = med_name.lower()
        if med_lower in self.medicines:
            med_info = self.medicines[med_lower]
            mg = med_info.get('mg', '')
            rack = med_info.get('rack_number', '')
            info_text = ""
            if mg:
                info_text += f"MG: {mg}"
            if rack:
                if info_text:
                    info_text += " | "
                info_text += f"Rack: {rack}"
            if info_text:
                self.medicine_info_label.config(text=info_text)
            else:
