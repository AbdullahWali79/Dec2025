    def generate_receipt(self, event=None):
        customer = self.customer_var.get().strip()
        if not customer:
            messagebox.showwarning("Warning", "Enter customer name!")
            return
        
        customer_phone = self.customer_phone_var.get().strip()
        if not customer_phone:
            messagebox.showwarning("Warning", "Enter customer phone number!")
            return
        
        if not self.invoice_items:
            messagebox.showwarning("Warning", "No items in invoice!")
            return
        
        # Calculate totals with discount
        subtotal = sum(item[4] for item in self.invoice_items)  # item[4] is total
        try:
            discount_percent = float(self.discount_var.get() or 0)
            if discount_percent < 0:
                discount_percent = 0
            if discount_percent > 100:
                discount_percent = 100
        except ValueError:
            discount_percent = 0
        
        discount_amount = subtotal * (discount_percent / 100)
        final_total = subtotal - discount_amount
        
        now = datetime.now()
        date_str = now.strftime("%Y%m%d_%H%M%S")
        filename = f"receipt_{customer.replace(' ', '_')}_{date_str}.pdf"
        
        # Create PDF
        c = canvas.Canvas(filename, pagesize=letter)
        width, height = letter
        y = height - 50  # Start from top
        
        # Header
        c.setFont("Helvetica-Bold", 16)
        c.drawString(50, y, "Pharmacy Receipt")
        y -= 30
        
        # Customer and Date
        c.setFont("Helvetica", 12)
        c.drawString(50, y, f"Customer: {customer}")
        y -= 20
        c.drawString(50, y, f"Phone: {customer_phone}")
        y -= 20
        c.drawString(50, y, f"Date: {now.strftime('%Y-%m-%d %H:%M:%S')}")
        y -= 40
        
        # Items
        c.setFont("Helvetica-Bold", 12)
        c.drawString(50, y, "Items:")
        y -= 20
        c.setFont("Helvetica", 10)
        currency_symbol = self.get_currency_symbol(self.currency_var.get())
        for item in self.invoice_items:
            med_name, mg, qty, price, item_total = item
            mg_text = f" ({mg})" if mg else ""
            line = f"{med_name}{mg_text} x{qty} @ {currency_symbol}{price:.2f} = {currency_symbol}{item_total:.2f}"
            c.drawString(50, y, line)
            y -= 15
            if y < 100:  # New page if needed
                c.showPage()
                y = height - 50
                c.setFont("Helvetica", 10)
        
        # Totals
        y -= 10
        c.setFont("Helvetica-Bold", 12)
        c.drawString(50, y, f"Subtotal: {currency_symbol}{subtotal:.2f}")
        y -= 20
        if discount_percent > 0:
            c.drawString(50, y, f"Discount ({discount_percent}%): -{currency_symbol}{discount_amount:.2f}")
            y -= 20
        c.setFont("Helvetica-Bold", 14)
        c.drawString(50, y, f"Grand Total: {currency_symbol}{final_total:.2f}")
        y -= 40
        
        # Footer
        c.setFont("Helvetica", 12)
        c.drawString(50, y, "Thank you! Visit again.")
        
        c.save()
        
        # Show success and ask about WhatsApp sharing
        response = messagebox.askyesno("Receipt Generated", 
                                       f"Receipt PDF downloaded!\nFile: {os.path.abspath(filename)}\n\n"
                                       f"Would you like to share this receipt via WhatsApp?")
        
        if response:
            self.share_via_whatsapp(filename, customer_phone, customer, subtotal, discount_percent, discount_amount, final_total)
        
        # Clear invoice
        self.invoice_items = []
        for item in self.invoice_tree.get_children():
            self.invoice_tree.delete(item)
        self.customer_var.set('')
        self.customer_phone_var.set('')
        self.discount_var.set('0')
        self.update_total()
        
        # Auto-save stock changes
        self.save_medicines()
    
    def format_phone_number(self, phone):
        """Format phone number for WhatsApp (add country code if missing)"""
        # Clean phone number (remove spaces, dashes, +, etc.)
        clean_phone = ''.join(filter(str.isdigit, phone))
        
        # If number starts with 0, remove it
        if clean_phone.startswith('0'):
            clean_phone = clean_phone[1:]
        
        # If number doesn't start with country code, add Pakistan code (92)
        # Pakistan numbers are typically 10 digits after removing 0
        if len(clean_phone) == 10:
            # Add Pakistan country code
            clean_phone = '92' + clean_phone
        elif len(clean_phone) == 11 and clean_phone.startswith('92'):
            # Already has country code
            pass
        elif len(clean_phone) < 10:
            # Too short, return as is
            pass
        
        return clean_phone
    
