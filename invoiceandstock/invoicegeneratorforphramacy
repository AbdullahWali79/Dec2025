    def on_search_type(self, event=None):
        query = self.search_var.get().lower()
        self.suggestions_listbox.delete(0, tk.END)
        self.current_suggestion_index = -1
        if query:
            matches = [name.capitalize() for name in self.medicines.keys() if query in name]
            for match in matches[:10]:  # Limit to 10 suggestions
                self.suggestions_listbox.insert(tk.END, match)
            # Auto-select first suggestion
            if matches:
                self.suggestions_listbox.selection_set(0)
                self.current_suggestion_index = 0
    
    def on_search_down(self, event):
        if self.suggestions_listbox.size() > 0:
            self.suggestions_listbox.focus_set()
            self.suggestions_listbox.selection_set(0)
            self.current_suggestion_index = 0
        return "break"
    
    def on_search_up(self, event):
        if self.suggestions_listbox.size() > 0:
            self.suggestions_listbox.focus_set()
            self.suggestions_listbox.selection_set(0)
            self.current_suggestion_index = 0
        return "break"
    
    def on_search_enter_or_add(self, event):
        """Handle Enter in search field - select medicine or add to invoice"""
        if self.suggestions_listbox.size() > 0 and self.current_suggestion_index >= 0:
            # First Enter: Select medicine from suggestions
            selected = self.suggestions_listbox.get(self.current_suggestion_index)
            self.search_var.set(selected)
            self.suggestions_listbox.delete(0, tk.END)
            # Stay in search field for second Enter
        else:
            # Second Enter: Add medicine to invoice
            self.add_to_invoice()
        return "break"
    
    def on_search_enter(self, event):
        if self.suggestions_listbox.size() > 0 and self.current_suggestion_index >= 0:
            selected = self.suggestions_listbox.get(self.current_suggestion_index)
