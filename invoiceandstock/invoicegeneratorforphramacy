    def create_thermal_receipt(self, customer, customer_phone=None):
        """Create thermal receipt content"""
        subtotal = sum(item[4] for item in self.invoice_items)  # item[4] is total
        if customer_phone is None:
            customer_phone = self.customer_phone_var.get().strip()
        
        # Calculate discount
        try:
            discount_percent = float(self.discount_var.get() or 0)
            if discount_percent < 0:
                discount_percent = 0
            if discount_percent > 100:
                discount_percent = 100
        except ValueError:
            discount_percent = 0
        
        discount_amount = subtotal * (discount_percent / 100)
        final_total = subtotal - discount_amount
        
        now = datetime.now()
        currency_symbol = self.get_currency_symbol(self.currency_var.get())
        
        # Receipt header
        receipt = []
        receipt.append("=" * 40)
        receipt.append("    PHARMACY RECEIPT")
        receipt.append("=" * 40)
        receipt.append(f"Customer: {customer}")
        receipt.append(f"Phone: {customer_phone}")
        receipt.append(f"Date: {now.strftime('%Y-%m-%d %H:%M:%S')}")
        receipt.append("-" * 40)
        receipt.append(f"{'Item':<18} {'MG':<6} {'Qty':<4} {'Price':<8} {'Total'}")
        receipt.append("-" * 40)
        
        # Items
        for item in self.invoice_items:
            med_name, mg, qty, price, item_total = item
            mg_display = mg[:5] if mg else ""
            med_display = med_name[:17] if len(med_name) <= 17 else med_name[:14] + "..."
            receipt.append(f"{med_display:<18} {mg_display:<6} {qty:<4} {currency_symbol}{price:<7.2f} {currency_symbol}{item_total:.2f}")
        
        receipt.append("-" * 40)
        receipt.append(f"Subtotal: {currency_symbol}{subtotal:.2f}")
        if discount_percent > 0:
            receipt.append(f"Discount ({discount_percent}%): -{currency_symbol}{discount_amount:.2f}")
        receipt.append(f"TOTAL: {currency_symbol}{final_total:.2f}")
        receipt.append("=" * 40)
        receipt.append("Thank you for your business!")
        receipt.append("Visit again soon!")
        receipt.append("=" * 40)
        
        return "\n".join(receipt)
    
    def print_thermal_receipt(self, receipt_content):
        """Print thermal receipt to default printer"""
        try:
            # Create temporary file
            with tempfile.NamedTemporaryFile(mode='w', suffix='.txt', delete=False) as temp_file:
                temp_file.write(receipt_content)
                temp_file_path = temp_file.name
            
            # Print using Windows print command
            if os.name == 'nt':  # Windows
                subprocess.run(['notepad', '/p', temp_file_path], check=True)
            else:  # Linux/Mac
                subprocess.run(['lp', temp_file_path], check=True)
            
            # Clean up
            os.unlink(temp_file_path)
            
        except Exception as e:
            raise Exception(f"Print failed: {str(e)}")
    
