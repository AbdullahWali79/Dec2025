    def on_search_type(self, event=None):
        query = self.search_var.get().lower()
        self.suggestions_listbox.delete(0, tk.END)
        self.current_suggestion_index = -1
        self.medicine_info_label.config(text="")  # Clear info when typing
        if query:
            matches = [name.capitalize() for name in self.medicines.keys() if query in name]
            for match in matches[:10]:  # Limit to 10 suggestions
                self.suggestions_listbox.insert(tk.END, match)
            # Auto-select first suggestion
            if matches:
                self.suggestions_listbox.selection_set(0)
                self.current_suggestion_index = 0
                # Show info for first match
                self.show_medicine_info(matches[0])
    
