    def add_to_invoice(self, event=None):
        med_name = self.search_var.get().strip()
        if not med_name:
            messagebox.showwarning("Warning", "Select a medicine first!")
            return
        
        # Try both original case and lowercase
        med_lower = med_name.lower()
        if med_lower not in self.medicines:
            # Try to find by partial match
            found = False
            for key in self.medicines.keys():
                if med_lower in key or key in med_lower:
                    med_lower = key
                    found = True
                    break
            
            if not found:
                messagebox.showwarning("Warning", "Medicine not found in stock!")
                return
        try:
            qty = int(self.qty_var.get())
            if qty <= 0:
                raise ValueError
        except ValueError:
            messagebox.showwarning("Warning", "Enter valid quantity > 0!")
            return
        
        med_info = self.medicines[med_lower]
        if qty > med_info['stock']:
            messagebox.showwarning("Warning", f"Only {med_info['stock']} in stock!")
            return
        
        # Update stock
        self.medicines_df.loc[self.medicines_df['Medicine_Name'].str.lower() == med_lower, 'Stock'] -= qty
        self.update_medicines_dict()
        
        total = qty * med_info['price']
        self.invoice_items.append((med_name, qty, med_info['price'], total))
        
        # Add to treeview with current currency
        currency_symbol = self.get_currency_symbol(self.currency_var.get())
        self.invoice_tree.insert('', 'end', values=(med_name, qty, f"{currency_symbol}{med_info['price']:.2f}", f"{currency_symbol}{total:.2f}"))
        
        self.search_var.set('')
        self.qty_var.set('1')
        self.update_total()
    
    def update_total(self):
        total = sum(item[3] for item in self.invoice_items)
        currency = self.currency_var.get()
        currency_symbol = self.get_currency_symbol(currency)
        self.total_var.set(f"Total: {currency_symbol}{total:.2f}")
    
    def get_currency_symbol(self, currency):
        symbols = {
            "PKR": "₨",
            "USD": "$",
            "EUR": "€",
            "GBP": "£"
        }
        return symbols.get(currency, "$")
    
    def on_currency_change(self, event=None):
        # Update the invoice tree display
        for item in self.invoice_tree.get_children():
            self.invoice_tree.delete(item)
        
        currency_symbol = self.get_currency_symbol(self.currency_var.get())
        
        for item in self.invoice_items:
            med_name, qty, price, total = item
            self.invoice_tree.insert('', 'end', values=(
                med_name, qty, f"{currency_symbol}{price:.2f}", f"{currency_symbol}{total:.2f}"
            ))
        
        self.update_total()
    
    def add_stock(self, event=None):
        # Simple dialog for manual add (extend for bulk Excel import if needed)
        name = simpledialog.askstring("Add Stock", "Medicine Name:")
