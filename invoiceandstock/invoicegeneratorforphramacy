    def generate_receipt(self, event=None):
        customer = self.customer_var.get().strip()
        if not customer:
            messagebox.showwarning("Warning", "Enter customer name!")
            return
        if not self.invoice_items:
            messagebox.showwarning("Warning", "No items in invoice!")
            return
        
        total = sum(item[3] for item in self.invoice_items)
        now = datetime.now()
        date_str = now.strftime("%Y%m%d_%H%M%S")
        filename = f"receipt_{customer.replace(' ', '_')}_{date_str}.pdf"
        
        # Create PDF
        c = canvas.Canvas(filename, pagesize=letter)
        width, height = letter
        y = height - 50  # Start from top
        
        # Header
        c.setFont("Helvetica-Bold", 16)
        c.drawString(50, y, "Pharmacy Receipt")
        y -= 30
        
        # Customer and Date
        c.setFont("Helvetica", 12)
        c.drawString(50, y, f"Customer: {customer}")
        y -= 20
        c.drawString(50, y, f"Date: {now.strftime('%Y-%m-%d %H:%M:%S')}")
        y -= 40
        
        # Items
        c.setFont("Helvetica-Bold", 12)
        c.drawString(50, y, "Items:")
        y -= 20
        c.setFont("Helvetica", 10)
        currency_symbol = self.get_currency_symbol(self.currency_var.get())
        for item in self.invoice_items:
            line = f"{item[0]} x{item[1]} @ {currency_symbol}{item[2]:.2f} = {currency_symbol}{item[3]:.2f}"
            c.drawString(50, y, line)
            y -= 15
            if y < 100:  # New page if needed
                c.showPage()
                y = height - 50
                c.setFont("Helvetica", 10)
        
        # Total
        y -= 10
        c.setFont("Helvetica-Bold", 14)
        c.drawString(50, y, f"Grand Total: {currency_symbol}{total:.2f}")
        y -= 40
        
        # Footer
        c.setFont("Helvetica", 12)
        c.drawString(50, y, "Thank you! Visit again.")
        
        c.save()
        
        messagebox.showinfo("Success", f"Receipt PDF downloaded!\nFile: {os.path.abspath(filename)}")
        
        # Optional: Auto-open the PDF (uncomment if desired)
        # os.startfile(filename)
        
        # Clear invoice
        self.invoice_items = []
        for item in self.invoice_tree.get_children():
            self.invoice_tree.delete(item)
        self.customer_var.set('')
        self.update_total()
        
        # Auto-save stock changes
        self.save_medicines()
    
